<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TreeViewController">
   <children>
      <HBox prefHeight="0.0" prefWidth="600.0">
         <children>
            <Button fx:id="main" mnemonicParsing="false" text="Main" />
            <Button fx:id="save" mnemonicParsing="false" text="Save" />
            <Button fx:id="add" mnemonicParsing="false" text="Add" />
            <Button fx:id="help" mnemonicParsing="false" text="Help" />
         </children>
      </HBox>
      <ScrollPane fx:id="scrollPane" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0">
         <content>
            <Group>
               <children>
                  <Pane fx:id="treePane" prefHeight="3000.0" prefWidth="3000.0" />
               </children>
            </Group>
         </content>
      </ScrollPane>
   </children>
</VBox>
